# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string (local Docker, Neon, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ─── App ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin for CORS (match the URL where Vite runs in dev)
CLIENT_URL=http://localhost:5173

# ─── KoboToolbox ─────────────────────────────────────────────────────────
KOBO_API_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=your_kobo_api_token_here

# ─── Google Sheets Backup ─────────────────────────────────────────────────
# Leave these unset to disable the backup feature entirely (safe no-op).
# See documentation for the step-by-step Google Cloud setup.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sparsha-backup@sparsha-backup.iam.gserviceaccount.com
