# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string (local Docker, Neon, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ─── App ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin for CORS (match the URL where Vite runs in dev)
CLIENT_URL=http://localhost:5173

# ─── KoboToolbox ─────────────────────────────────────────────────────────
KOBO_API_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=your_kobo_api_token_here

# ─── Google Sheets Backup ─────────────────────────────────────────────────
# Leave these unset to disable the backup feature entirely (safe no-op).
#
# RECOMMENDED: paste the entire downloaded service account JSON file,
# base64-encoded into one line, into GOOGLE_SERVICE_ACCOUNT_JSON_BASE64.
# This avoids every manual-escaping mistake (stray \n, smart quotes, CRLF)
# that causes "error:1E08010C:DECODER routines::unsupported".
#
# Windows PowerShell (run in the folder where the JSON file was downloaded):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("sparsha-backup-XXXXX.json")) | Set-Clipboard
# Then paste the clipboard contents as the value below.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Alternative (only used if the above is not set): paste the two fields
# separately. More error-prone — prefer the base64 method above.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

GOOGLE_SHEET_ID=your_google_sheet_id_here

